# نمونه پیکربندی MASEF 0.2 برای اجرای خودمختار در Workspace.
# پیش از کپی به `.codex/config.toml`، سازگاری گزینه‌ها را با نسخه Codex نصب‌شده بررسی کنید.

approval_policy = "never"
sandbox_mode = "workspace-write"
allow_login_shell = false
web_search = "live"

[sandbox_workspace_write]
network_access = true

# مرزهای واقعی اقدام در AGENTS.md تعریف شده‌اند:
# کارهای محلی، تست، Git روی شاخه کاری و پژوهش فنی بدون توقف انجام می‌شوند.
# Secret، خرید، حذف داده مهم، اقدام برگشت‌ناپذیر و Production پرخطر نیازمند تصمیم انسانی‌اند.
# برای پروژه بحرانی می‌توان approval_policy را به "on-request" تغییر داد.
